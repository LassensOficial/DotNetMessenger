@page "/chats"

@inject HttpClient httpClient

<h2>
    @(Notification != null ? Notification : string.Empty)
</h2>

<div class="chats">
    @foreach (ChatDto chat in CurrentUser.Chats)
    {
        <button class="chat_btn" @onclick="() => RedirectToChat(chat.Id)">
            <div class="chat">
                @GetChatName(chat.UserNameInChat, CurrentUser.CurrentUser.UserName)
            </div>
        </button>
    }
</div>