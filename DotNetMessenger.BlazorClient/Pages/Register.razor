@page "/register"

@inject NavigationManager navigationManager
@inject HttpClient httpClient
@inject User currentUser

<h1>
    Зарегестрируйтесь.
</h1>

<div class="top-bar">
    <span class="user-id">ID: @user.Id</span>
    <span class="user-name">Имя: @user.UserName</span>
</div>

<div class="mb-2">
    <label class="form-label">Имя</label>
    <input class="form-control" @bind="Name"/>
</div>

<div class="mb-2">
    <label class="form-label">Пароль</label>
    <input class="form-control" @bind="Password"/>
</div>

<div>
    <button @onclick="SendMessageAsync">
        Отправить
    </button>
</div>

<div>
    <button @onclick="GoLoginAsync">
        Уже есть аккаунт? Войти
    </button>
</div>

<h2>
    @(Notification != null ? Notification : string.Empty)
</h2>


@code
{
    private string Name {get;set;}
    private string Password {get;set;}

    private string Notification {get;set;}

    private string SessionKey { get; set; }

    private Response user = new Response(0,"","");    

    private async Task SendMessageAsync()
    {
        RequestRegister request = new RequestRegister(Name, Password);

        try
        {
            var response = await httpClient.PostAsJsonAsync("http://localhost:5166/api/Register", request);

            if (response.IsSuccessStatusCode)
            {
                user = await response.Content.ReadFromJsonAsync<Response>();

                currentUser.user = user;

                Notification = $"Успешная регистрация, {user.UserName}, твой ID : {user.Id}";            
            }
            else
            {
                string exception = await response.Content.ReadAsStringAsync();

                Notification = $"Ошибка: {exception}";
            }
        }
        catch(Exception ex)
        {
            Notification = $"Ошибка : {ex.Message}";
        }
    }

    private async Task GoLoginAsync()
    {
        navigationManager.NavigateTo("login");
    }

    private record RequestRegister(string Name, string Password);
}