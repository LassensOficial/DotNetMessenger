@page "/chats"

@inject HttpClient HttpClient

<div class="chats-header">
    <h2>@(Notification != null ? Notification : string.Empty)</h2>
    <button class="action-btn" @onclick="NewChat">Новый чат!</button>
</div>

<div class="chats">
    @foreach (ChatDto chat in CurrentUser.Chats)
    {
        <button class="chat_btn" @onclick="() => RedirectToChat(chat.Id)">
            <div class="chat">
                @GetChatName(chat.UserNameInChat, CurrentUser.CurrentUser.UserName)
            </div>
        </button>
    }
</div>