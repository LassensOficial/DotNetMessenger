@page "/login"

<PageTitle>Авторизация</PageTitle>

<div class="login-page">
    <div class="login-card @(IsSuccess ? "fade-out-card" : "")">
        
        @if (!IsSuccess)
        {
            <!-- ШАПКА ФОРМЫ -->
            <div class="login-header">
                <h1>С возвращением!</h1>
                <p>Войдите в свой аккаунт, чтобы продолжить общение</p>
            </div>

            <!-- ИНПУТ: ИМЯ -->
            <div class="input-group">
                <input id="login-name" type="text" required @bind="Name" />
                <label for="login-name">Ваше имя</label>
                <div class="bar"></div>
            </div>

            <!-- ИНПУТ: ПАРОЛЬ -->
            <div class="input-group">
                <input id="login-pass" type="password" required @bind="Password" />
                <label for="login-pass">Пароль</label>
                <div class="bar"></div>
            </div>

            <!-- УВЕДОМЛЕНИЯ ОБ ОШИБКАХ -->
            @if (!string.IsNullOrEmpty(Notification))
            {
                <div class="notification-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@Notification</span>
                </div>
            }

            <!-- КНОПКА ДЕЙСТВИЯ -->
            <div class="action-zone">
                <button class="btn-primary" @onclick="LoginAsync">
                    <span>Войти в аккаунт</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                </button>

                <a href="/register" class="link-register">Ещё нет аккаунта? Зарегистрироваться</a>
            </div>
        }
    </div>

    <!-- АНИМАЦИЯ ОТКРЫВАЮЩЕГОСЯ ЗАМКА -->
    @if (IsSuccess)
    {
        <div class="success-overlay">
            <div class="lock-wrapper">
                <div class="lock-shackle"></div>
                <div class="lock-body">
                    <div class="lock-keyhole"></div>
                </div>
            </div>
            <h2>Успешный вход!</h2>
            <p>Загружаем ваши чаты и сообщения...</p>
        </div>
    }
</div>

<style>
    /* Полностью убираем любые ограничения высоты и скролла для этой страницы */
    .page main .content,
    main article.content {
        padding: 0 !important;
        max-width: 100% !important;
        height: auto !important;
    }

    html,
    body,
    main {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        height: auto !important;
        position: static !important;
        /* Убираем фиксацию экрана */
    }
</style>