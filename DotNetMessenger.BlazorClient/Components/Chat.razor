@page "/chats/{Id:int}/chat/"

<div class="chat-container">
    
    <!-- ВЕРХНЯЯ ПАНЕЛЬ (Шапка чата) -->
    <div class="chat-header">
        <!-- Сюда вы поставите аватарку, имя и id -->
        <div class="chat-header-info">
            <div class="mock-avatar"></div>
            <div>
                <h3>
                    @GetChatName(CurrentChat.UserNameInChat, CurrentUser.CurrentUser.UserName)
                </h3>
                <span class="status">неизвестно</span>
            </div>
        </div>
    </div>

    <!-- ЗОНА СООБЩЕНИЙ (Скроллится, если сообщений много) -->
    <div class="chat-messages">
        @* @foreach (var message in Messages) { *@
        @foreach (Message message in CurrentChat.Messages)
        {
            if (message.OwnerId != CurrentUser.CurrentUser.Id)
            {
                <!-- Пример входящего сообщения -->
                <div class="message incoming">
                    <div class="message-content">
                        @message.Context
                    </div>
                </div>
            }
            else
            {
                <!-- Пример исходящего сообщения -->
                <div class="message outgoing">
                    <div class="message-content">
                        @message.Context
                    </div>
                </div>
            }
        }
    </div>

    <!-- НИЖНЯЯ ПАНЕЛЬ (Ввод сообщения) -->
    <div class="chat-input-zone">
        <div class="input-wrapper">
            <input type="text" placeholder="Напишите сообщение..." class="message-input" @bind="Context" />
            <button class="send-btn" @onclick="SendMessageAsync">
                <!-- Иконка бумажного самолетика (SVG) -->
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
        </div>
    </div>

</div>

<style>
    /* Убираем дефолтные отступы контента в MainLayout для страницы чата */
    .page main .content,
    main article.content {
        padding: 0 !important;
        max-width: 100% !important;
        height: 100% !important;
    }

    /* 
       Принудительно отключаем внешний скролл самого шаблона Blazor.
       Это лечит наложение элементов друг на друга на телефонах.
    */
    main,
    html,
    body {
        overflow: hidden !important;
        height: 100vh !important;
    }
</style>