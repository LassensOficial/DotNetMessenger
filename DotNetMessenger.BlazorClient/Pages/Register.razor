@page "/"
@page "/register"

<PageTitle>Регистрация</PageTitle>

<div class="register-page">
    <div class="register-card @(IsSuccess ? "fade-out-card" : "")">

        @if (!IsSuccess)
        {
            <!-- ШАПКА ФОРМЫ -->
            <div class="register-header">
                <h1>Создать аккаунт</h1>
                <p>Присоединяйтесь к нашему мессенджеру прямо сейчас</p>
            </div>

            <!-- ИНПУТ: ИМЯ -->
            <div class="input-group">
                <input id="reg-name" type="text" required @bind="Name" />
                <label for="reg-name">Ваше имя</label>
                <div class="bar"></div>
            </div>

            <!-- ИНПУТ: ПАРОЛЬ -->
            <div class="input-group">
                <input id="reg-pass" type="password" required @bind="Password" />
                <label for="reg-pass">Придумайте пароль</label>
                <div class="bar"></div>
            </div>

            <!-- УВЕДОМЛЕНИЯ ОБ ОШИБКАХ -->
            @if (!string.IsNullOrEmpty(Notification))
            {
                <div class="notification-error">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>@Notification</span>
                </div>
            }

            <!-- КНОПКИ ДЕЙСТВИЯ -->
            <div class="action-zone">
                <button class="btn-primary" @onclick="RegisterAsync">
                    <span>Зарегистрироваться</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 5"></polyline>
                    </svg>
                </button>

                <button class="btn-secondary" @onclick="GoLoginAsync">
                    Уже есть аккаунт? Войти
                </button>
            </div>
        }
    </div>

    <!-- ТА САМАЯ АНИМАЦИЯ УСПЕХА -->
    @if (IsSuccess)
    {
        <div class="success-overlay">
            <div class="success-checkmark">
                <div class="check-icon">
                    <span class="icon-line line-tip"></span>
                    <span class="icon-line line-long"></span>
                    <div class="icon-circle"></div>
                    <div class="icon-fix"></div>
                </div>
            </div>
            <h2>Добро пожаловать, @Name!</h2>
            <p>Регистрация прошла успешно. Перенаправляем в приложение...</p>
        </div>
    }
</div>

<style>
    /* Полностью убираем любые ограничения высоты и скролла для этой страницы */
    .page main .content,
    main article.content {
        padding: 0 !important;
        max-width: 100% !important;
        height: auto !important;
    }

    html,
    body,
    main {
        overflow-y: auto !important;
        overflow-x: hidden !important;
        height: auto !important;
        position: static !important;
        /* Убираем фиксацию экрана */
    }
</style>